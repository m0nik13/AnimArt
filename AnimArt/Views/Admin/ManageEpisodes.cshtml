@model AnimArt.Entities.Anime
@{
    ViewData["Title"] = $"Серії: {Model.Title}";
    Layout = "_AdminLayout";
}

<div class="admin-container">
    <div class="admin-header">
        <h2 class="admin-title">Керування серіями: @Model.Title</h2>
        <a asp-action="Anime" class="btn-secondary">Назад до списку</a>
    </div>

    <div class="form-content" style="margin-bottom: 30px;">
        <h3>Додати/Оновити серію</h3>
        <form asp-action="AddEpisode" method="post" class="compact-form">
            <input type="hidden" name="animeId" value="@Model.Id" />
            <div class="form-columns">
                <div class="form-group">
                    <label>Номер серії</label>
                    <input type="number" name="episodeNumber" class="form-input" required min="1" value="@(Model.Episodes.Count + 1)" />
                </div>
                <div class="form-group">
                    <label>Назва (необов'язково)</label>
                    <input type="text" name="title" class="form-input" placeholder="Наприклад: Початок шляху" />
                </div>
            </div>
            <div class="form-group">
                <label>Посилання на відео (MP4/YouTube)</label>
                <input type="text" name="videoUrl" class="form-input" required placeholder="https://..." />
            </div>
            <button type="submit" class="btn-primary">Зберегти</button>
        </form>
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>№</th>
                    <th>Назва</th>
                    <th>Посилання</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ep in Model.Episodes.OrderBy(e => e.Id))
                {
                    <tr>
                        <td>@ep.Id</td>
                        <td>@ep.Title</td>
                        <td class="truncate" style="max-width: 200px;">@ep.VideoUrl</td>
                        <td>
                            <form asp-action="DeleteEpisode" method="post" style="display:inline;">
                                <input type="hidden" name="animeId" value="@Model.Id" />
                                <input type="hidden" name="episodeNumber" value="@ep.Id" />
                                <button type="submit" class="btn-danger btn-sm">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>