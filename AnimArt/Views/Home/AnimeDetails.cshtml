                width: 150px;
                height: 225px;
            }

            .anime-title-mobile {
                font-size: 1.6rem;
            }

            .stats-grid-mobile {
                grid-template-columns: repeat(4, 1fr);
            }
        }
</style>
@section Scripts {
    <script src="https://cdn.plyr.io/3.7.8/plyr.js"></script>
    <script>
        function showReviewForm() {
            document.getElementById('reviewForm').style.display = 'block';
        }

        function hideReviewForm() {
            document.getElementById('reviewForm').style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', function() {
            const watchStatusBtn = document.querySelector('.watch-status-btn');
            if (watchStatusBtn) {
                watchStatusBtn.addEventListener('click', function() {
                    const isNotWatching = this.classList.contains('not-watching');

                    if (isNotWatching) {
                        this.classList.remove('not-watching');
                        this.classList.add('watching');
                        this.innerHTML = '<i class="fas fa-eye"></i><span>Дивлюсь</span>';
                    } else {
                        this.classList.remove('watching');
                        this.classList.add('not-watching');
                        this.innerHTML = '<i class="fas fa-eye-slash"></i><span>Не дивлюсь</span>';
                    }
                });
            }
        });
        document.addEventListener('DOMContentLoaded', () => {
            
            const player = new Plyr('#player', {
                controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'captions', 'settings', 'pip', 'airplay', 'fullscreen'],
                iconUrl: 'https://cdn.plyr.io/3.7.8/plyr.svg',
            });

            window.player = player;
        });

        function changeEpisode(element, url, episodeNum) {
            if (!window.player) return;

                window.player.source = {
            type: 'video',
            sources: [{ src: url, type: 'video/mp4' }],
            poster: '@Model.Anime.PosterUrl'
            };
            const allButtons = document.querySelectorAll('.episode-btn');
                allButtons.forEach(btn => {
                btn.classList.remove('active');
            });
            element.classList.add('active');

            window.player.play();
        }
    </script>
}