@model AnimeDetailsViewModel
@{
    ViewData["Title"] = Model.Anime.Title;
}
<link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
<div class="anime-details-mobile">
    <!-- Постер і основна інформація -->
    <div class="anime-header-mobile">
        <div class="anime-poster-mobile">
            @if (!string.IsNullOrEmpty(Model.Anime.PosterUrl))
            {
                <img src="@Model.Anime.PosterUrl" alt="@Model.Anime.Title" class="poster-image-mobile">
            }
            else
            {
                <div class="poster-placeholder-mobile">
                    <i class="fas fa-image"></i>
                    <span>Постер відсутній</span>
                </div>
            }
        </div>

        <div class="anime-basic-info">
            <h1 class="anime-title-mobile">@Model.Anime.Title</h1>
            @if (!string.IsNullOrEmpty(Model.Anime.OriginalTitle) && Model.Anime.OriginalTitle != Model.Anime.Title)
            {
                <h2 class="anime-original-title-mobile">@Model.Anime.OriginalTitle</h2>
            }

            <!-- Статус перегляду -->
            <div class="watch-status-section">
                <button class="watch-status-btn not-watching">
                    <i class="fas fa-eye-slash"></i>
                    <span>Не дивлюсь</span>
                </button>
                <div class="watch-count">55 181</div>
            </div>
            <div class="description-section-mobile">
                <h3 class="section-title-mobile">Опис</h3>
                <div class="description-content-mobile">
                    @if (!string.IsNullOrEmpty(Model.Anime.Description))
                    {
                        <p>@Model.Anime.Description</p>
                    }
                    else
                    {
                        <p class="no-description">Опис відсутній</p>
                    }
                </div>
            </div>
        </div>
    </div>
    @if (Model.Anime.Episodes != null && Model.Anime.Episodes.Any())
    {
        <div class="theater-layout">
            <div class="video-main-container">
                <video id="player" playsinline controls data-poster="@Model.Anime.PosterUrl">
                    <source src="@Model.Anime.Episodes.OrderBy(e => e.Id).First().VideoUrl" type="video/mp4" />
                </video>
            </div>

            <div class="episodes-panel">
                <div class="episodes-header">
                    <span class="episodes-count">Всі серії (@Model.Anime.Episodes.Count)</span>
                </div>

                <div class="episodes-grid">
                    @foreach (var ep in Model.Anime.Episodes.OrderBy(e => e.Id))
                    {
                        <div class="episode-btn @(ep.Id == 1 ? "active" : "")"
                             onclick="changeEpisode(this, '@ep.VideoUrl', @ep.Id)"
                             title="@ep.Title">
                            <div class="ep-num">Серія @ep.Id</div>
                            <div class="ep-name">
                                <i class="fas fa-play"></i>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="no-episodes-msg">
            <i class="fas fa-video-slash"></i>
            <p>Серії ще не додані</p>
        </div>
    }
    <!-- Мета-інформація -->
    <div class="anime-meta-mobile">
        <div class="meta-item-mobile">
            <span class="meta-label">Країна:</span>
            <span class="meta-value">Японія</span>
        </div>
        <div class="meta-item-mobile">
            <span class="meta-label">Сезон:</span>
            <span class="meta-value">Осінь 2025</span>
        </div>
        <div class="meta-item-mobile">
            <span class="meta-label">Серій:</span>
            <span class="meta-value">@Model.Anime.ReleasedEpisodes з @Model.Anime.TotalEpisodes</span>
        </div>
        <div class="meta-item-mobile">
            <span class="meta-label">Тривалість:</span>
            <span class="meta-value">@Model.Anime.DurationPerEpisode хв</span>
        </div>
        <div class="meta-item-mobile">
            <span class="meta-label">Статус:</span>
            <span class="meta-value status-@Model.Anime.Status.ToString().ToLower()">@Model.Anime.Status</span>
        </div>
        @if (Model.Studios.Any())
        {
            <div class="meta-item-mobile">
                <span class="meta-label">Студія:</span>
                <span class="meta-value">@Model.Studios.First().Name</span>
            </div>
        }
    </div>

    <!-- Жанри -->
    @if (Model.Genres.Any())
    {
        <div class="genres-section-mobile">
            <div class="genres-list-mobile">
                @foreach (var genre in Model.Genres)
                {
                    <span class="genre-tag-mobile">@genre.Name</span>
                }
            </div>
        </div>
    }

    <!-- Рейтинг -->
    <div class="rating-section-mobile">
        <div class="rating-display-mobile">
            <div class="rating-score-mobile">@Model.AverageRating.ToString("0.0")</div>
            <div class="rating-stars-mobile">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="fas fa-star @(i <= Model.AverageRating / 2 ? "active" : "")"></i>
                }
            </div>
            <div class="rating-count-mobile">@Model.TotalRatings голосів</div>
        </div>
    </div>

    <!-- Статистика користувачів -->
    <div class="user-stats-mobile">
        <div class="stats-grid-mobile">
            <div class="stat-item-mobile">
                <div class="stat-value-mobile">27 460</div>
                <div class="stat-label-mobile">Дивляться</div>
            </div>
            <div class="stat-item-mobile">
                <div class="stat-value-mobile">6 159</div>
                <div class="stat-label-mobile">Відкладено</div>
            </div>
            <div class="stat-item-mobile">
                <div class="stat-value-mobile">74 001</div>
                <div class="stat-label-mobile">В планах</div>
            </div>
            <div class="stat-item-mobile">
                <div class="stat-value-mobile">799</div>
                <div class="stat-label-mobile">Кинули</div>
            </div>
        </div>
    </div>

    <!-- Кадри (заглушка) -->
    <div class="screenshots-section-mobile">
        <h3 class="section-title-mobile">Кадри</h3>
        <div class="screenshots-placeholder">
            <i class="fas fa-images"></i>
            <span>Кадри будуть додані пізніше</span>
        </div>
    </div>

    <!-- Коментарі -->
    <div class="comments-section-mobile">
        <div class="comments-header-mobile">
            <h3 class="section-title-mobile">Коментарі</h3>
            <button class="add-comment-btn" onclick="showReviewForm()">
                <i class="fas fa-plus"></i>
                Додати коментар
            </button>
        </div>

        <!-- Форма додавання коментаря -->
        <div id="reviewForm" class="review-form-mobile" style="display: none;">
            <h4>Додати коментар</h4>
            <form asp-action="AddReview" method="post">
                <input type="hidden" name="animeId" value="@Model.Anime.Id" />
                <div class="form-group-mobile">
                    <input type="text" name="title" class="form-input-mobile" placeholder="Заголовок" required maxlength="100" />
                </div>
                <div class="form-group-mobile">
                    <textarea name="content" class="form-textarea-mobile" rows="4" placeholder="Ваш коментар..." required maxlength="1000"></textarea>
                </div>
                <div class="form-group-mobile">
                    <label class="checkbox-label-mobile">
                        <input type="checkbox" name="containsSpoilers" />
                        <span class="checkmark-mobile"></span>
                        Містить спойлери
                    </label>
                </div>
                <div class="form-actions-mobile">
                    <button type="submit" class="btn-primary-mobile">Опублікувати</button>
                    <button type="button" class="btn-secondary-mobile" onclick="hideReviewForm()">Скасувати</button>
                </div>
            </form>
        </div>

        <!-- Список коментарів -->
        <div class="comments-list-mobile">
            @if (Model.Reviews.Any())
            {
                foreach (var review in Model.Reviews.Take(5))
                {
                    <div class="comment-item-mobile @(review.ContainsSpoilers ? "has-spoilers" : "")">
                        <div class="comment-header-mobile">
                            <div class="comment-author-mobile">Користувач #@review.UserId</div>
                            <div class="comment-date-mobile">@review.CreatedAt.ToString("dd.MM.yyyy")</div>
                        </div>
                        <h4 class="comment-title-mobile">@review.Title</h4>
                        <p class="comment-content-mobile">@review.Content</p>
                        @if (review.ContainsSpoilers)
                        {
                            <div class="spoiler-warning-mobile">
                                <i class="fas fa-exclamation-triangle"></i>
                                Містить спойлери
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="no-comments-mobile">
                    <i class="fas fa-comments"></i>
                    <p>Поки що немає коментарів. Будьте першим!</p>
                </div>
            }
        </div>
    </div>
</div>
<style>
